# Copy to /etc/monitor/monitor.env on the server (root:root, mode 0600).
# deploy/deploy.sh can generate this file automatically as
# deploy/monitor.env.local; never commit the real values.
#
# Panel login password. Use a long random value, e.g.:
#   openssl rand -base64 24
MONITOR_PASSWORD=replace-with-a-long-random-password

# HMAC key used to sign the panel session cookie. Use 32 random bytes:
#   openssl rand -hex 32
MONITOR_SECRET=replace-with-64-hex-characters

# Credentials for the optional local mail-panel send API.
# Leave empty if email alerts are not needed.
MAIL_API_KEY_ID=
MAIL_API_SECRET=
